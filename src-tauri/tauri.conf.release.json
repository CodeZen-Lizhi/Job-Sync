{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JobPilot",
  "version": "../package.json",
  "identifier": "com.administrator.jobpilot",
  "build": {
    "beforeDevCommand": "npm run build:worker && npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run stage:worker:runtime && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "JobPilot",
        "width": 1200,
        "minWidth": 1100,
        "height": 800,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["bin/"],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
